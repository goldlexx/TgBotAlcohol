{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tgbot-alcohol",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tgbot-alcohol-test",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "CLOSED_TEST": "1"
  }
}
